CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws
VITE_PUBLIC_BACKEND_URL=

WHATSAPP_SEND_MODE=real
META_GRAPH_API_VERSION=v21.0
