DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=crm.example.com,localhost,backend
CORS_ALLOWED_ORIGINS=https://crm.example.com
