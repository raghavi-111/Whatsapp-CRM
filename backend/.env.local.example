# Copy this file to backend/.env.local for local Windows backend development.
# It is loaded by Django only when the backend is not running inside Docker.

DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3003,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3003,http://127.0.0.1:5173,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3003,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3003,http://127.0.0.1:5173,http://127.0.0.1:8000
